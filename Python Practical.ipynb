def visualize_test_data(test_df, residuals, ideal_df): 

“”” 

# Visualize test data and residuals using bokeh. 

Args: 

        test_df (pandas.DataFrame): DataFrame containing test data. 

        residuals (dict): Dictionary containing residuals for each test data point. 

        ideal_df (pandas.DataFrame): DataFrame containing ideal functions. 

    """ 

output_file("test_data.html") 

        p = figure(title="Test Data with Residuals",x_axis_label='x', y_axis_label='y', 

                    width=800,  

                   height=400) 

         

        # Plot test data points 

  p.circle(test_df['x'], test_df['y'], legend_label='Test Data', color='blue',size=8) 

 

        # Plot residual lines 

        for idx, res in residuals.items(): x_val, y_test, closest_ideal, residual = res 

 

            # Find corresponding ideal y value 

            mask = np.isclose(ideal_df['x'], x_val, rtol=1e-5, atol=1e-8) 

            if mask.any(): y_ideal = ideal_df.loc[mask, closest_ideal].values[0] 

                               p.line([x_val, x_val], [y_test, y_ideal], line_width=2,  

                                              color='red', alpha=0.6) 

            

        p.legend.click_policy = "hide" 

        save(p) 

 

class DataVisualizer: 

    @staticmethod 

    def plot_data(training_df, ideal_df, test_df, residuals, best_ideal_funcs): 

“”” 

Plot training data, ideal functions, test data and residuals using bokeh. 

Args: 

            training_df (pandas.DataFrame): DataFrame containing training data. 

            ideal_df (pandas.DataFrame): DataFrame containing ideal functions. 

            test_df (pandas.DataFrame): DataFrame containing test data. 

            residuals (dict): Dictionary containing residuals for each test data point. 

            best_ideal_funcs (dict): Dictionary mapping each training function to its best ideal function. 

        """ 

            # Calculate common axis ranges 

            x_min = min(training_df['x'].min(), test_df['x'].min()) 

            x_max = max(training_df['x'].max(), test_df['x'].max()) 

            y_min = min(training_df.iloc[:, 1:].min().min(),  

                       ideal_df.iloc[:, 1:].min().min(), test_df['y'].min())  

            y_max = max(training_df.iloc[:, 1:].max().max(),  

                       ideal_df.iloc[:, 1:].max().max(),   test_df['y'].max()) 

 

            # Add some padding 

            x_padding = (x_max - x_min) * 0.05 

            y_padding = (y_max - y_min) * 0.05 

            x_range = (x_min - x_padding, x_max + x_padding) 

            y_range = (y_min - y_padding, y_max + y_padding) 

             

            # Create first plot for training data and ideal functions 

            p1 = figure(title="Training Data vs Ideal Functions", 

                 x_axis_label='x', y_axis_label='y', x_range=x_range, y_range=y_range, 

                        width=800, 

                        height=400) 

             

            # Plot training data 

            for col in training_df.columns[1:]: 

            p1.line(training_df['x'], training_df[col],legend_label=f"Training {col}",  

              line_width=2, line_color='blue') 

                   

            # Plot ideal functions 

            colors = ['red', 'green', 'orange', 'purple'] 

            for i, col in enumerate(best_ideal_funcs.values()): 

            p1.line(ideal_df['x'], ideal_df[col], legend_label=f"Ideal {col}",  

            line_width=2, line_dash="dashed", line_color=colors[i % len(colors)]) 

            p1.legend.click_policy = "hide" 

            p1.legend.location = "top_left" 

             

            # Create second plot for test data and residuals 

            p2 = figure(title="Test Data and Residuals", 

                 x_axis_label='x', y_axis_label='y', x_range=x_range, y_range=y_range, 

                 width=800, height=400) 

         

            # Plot test data points 

            p2.scatter(test_df['x'], test_df['y'],legend_label="Test Data", color="red", 

                       size=8) 

             

            # Plot residual lines 

            for idx, (x, y_test, closest_ideal, residual) in residuals.items(): 

                mask = np.isclose(ideal_df['x'], x, rtol=1e-5, atol=1e-8) 

                if mask.any(): y_ideal = ideal_df.loc[mask, closest_ideal].values[0] 

              p2.line([x, x], [y_test, y_ideal], line_width=1,color="black", alpha=0.5) 

          

            p2.legend.click_policy = "hide" 

            p2.legend.location = "top_left" 

             

            # Show combined plot 

            show(column(p1, p2)) 

            print("Combined visualization displayed") 

class TestFunctions(unittest.TestCase): 

    def setUp(self): 

        """Set up test fixtures.""" 

        self.test_csv = 'test_temp.csv' 

         

    def tearDown(self): 

        """Clean up after tests.""" 

        if os.path.exists(self.test_csv): 

            os.remove(self.test_csv) 

     

    def test_load_data_from_csv(self): 

        """Test loading data from CSV file.""" 

        # Create test CSV 

        test_data = pd.DataFrame({ 

            'x': range(10), 

            'y': np.random.rand(10) 

        }) 

        test_data.to_csv(self.test_csv, index=False) 

         

        test_df = load_data_from_csv(self.test_csv) 

        self.assertEqual(len(test_df), 10) 

        self.assertIn('x', test_df.columns) 

 

def test_find_best_ideal_functions(self): 

 

"""Test finding best ideal functions.""" 

training_df = pd.DataFrame({ 'x': range (10), 'y1': np.random.rand(10), 'y2': np.random.rand(10)}) 

 ideal_df = pd.DataFrame({'x': range(10), 'y1': np.random.rand(10), 'y2': np.random.rand(10)}) 

         

        best_ideal_funcs = find_best_ideal_functions(training_df, ideal_df) 

        self.assertEqual(len(best_ideal_funcs), len(training_df.columns) - 1) 

        self.assertIsInstance(best_ideal_funcs, dict) 

 

def test_approximate_test_data(self): 

        """Test test data approximation.""" 

        np.random.seed(42) 

 

        residuals = approximate_test_data(test_df, ideal_df, best_ideal_funcs) 

        self.assertEqual(len(residuals), len(test_df)) 

        for idx, res in residuals.items(): 

            self.assertEqual(len(res), 4)  # x, y_test, closest_ideal, residual 

 

